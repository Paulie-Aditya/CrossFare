{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://crossfare.example.com/v1/:path*" },
    { "source": "/demo/:path*", "destination": "https://crossfare.example.com/demo/:path*" },
    { "source": "/.well-known/x402", "destination": "https://crossfare.example.com/.well-known/x402" }
  ]
}

{
  "name": "crossfare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:venues": "node --env-file=.env scripts/check-venues.ts",
    "setup:topic": "node --env-file=.env scripts/create-hcs-topic.ts",
    "setup:usdc": "node --env-file=.env scripts/associate-usdc.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@crossfare/core": "workspace:*",
    "@hiero-ledger/sdk": "^2.90.1"
  }
}

# Names only. Never commit values.

# Uniswap Trading API
UNISWAP_API_KEY=
# Optional: Crossfare's fee on Uniswap swaps goes to this EVM address. Unset charges nothing.
UNISWAP_FEE_RECIPIENT=
# The fee in bps (0 to 500) for callers whose VIP key sets none. Unset is 0. Set a key's own with vip-cli.
UNISWAP_FEE_BPS=

# SwapKit API
SWAPKIT_API_KEY=

# Direct venues, optional. Each turns on when its recipient is set; SwapKit stays the fallback.
# NEAR Intents: an Intents account (name.near, implicit or EVM address) and the fee in bps. 1Click keeps half, at least 20 bps.
NEAR_INTENTS_FEE_RECIPIENT=
NEAR_INTENTS_FEE_BPS=
# A 1Click partner key, if you have one.
NEAR_INTENTS_API_KEY=
# THORChain: a registered THORName, short enough for an 80-byte memo, and the fee in bps (up to 1000).
THORCHAIN_AFFILIATE=
THORCHAIN_AFFILIATE_BPS=
# Unset uses a public THORNode.
THORNODE_URL=

# Arkiv writer wallet (testnet funds only)
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

# Hedera testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_PAY_TO_ACCOUNT=
HEDERA_USDC_TOKEN_ID=
HEDERA_HCS_TOPIC_ID=
X402_FACILITATOR_URL=

# Reference agent
AGENT_HEDERA_ACCOUNT=
# Private key, not the account's address. Testnet fees only; also used on the server.
AGENT_HEDERA_KEY=
# Signs swaps with real money. Use a dedicated wallet and never put this on the server.
AGENT_EVM_PRIVATE_KEY=

# Optional overrides
# Unset means POST /v1/swap is free. A price such as 0.05 turns on x402 for it.
SWAP_PRICE_USDC=
BASE_RPC_URL=
ETHEREUM_RPC_URL=
# Any other chain Uniswap trades on, by chain ID, e.g. RPC_URL_42161 for Arbitrum. Unset uses public RPCs.
PORT=
DATABASE_PATH=
WEB_ROOT=

# Pays the x402 fee for visitors to the UI. Testnet only. Defaults to the agent account.
DEMO_HEDERA_ACCOUNT=
DEMO_HEDERA_KEY=
DEMO_LIMIT_PER_IP_HOUR=
DEMO_LIMIT_PER_DAY=

# Agent limits and safety. Swaps spend real funds: "true" is the only value that enables them.
CROSSFARE_API_URL=
AGENT_ALLOWED_PAY_TO=
AGENT_ALLOW_LIVE_SWAPS=
AGENT_PER_CALL_CAP_USDC=
AGENT_BUDGET_USDC=
